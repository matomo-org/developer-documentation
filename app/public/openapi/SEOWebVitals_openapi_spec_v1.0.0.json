    "paths": {
        "/index.php?module=API&method=SEOWebVitals.configureTopPageUrls": {
            "get": {
                "tags": [
                    "SEOWebVitals"
                ],
                "description": "Automatically configure the most popular page URLs to be monitored by SEO Web Vitals for the given site.",
                "operationId": "SEOWebVitals.configureTopPageUrls",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/formatOptional"
                    },
                    {
                        "name": "idSite",
                        "in": "query",
                        "description": "The site ID.",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of monitored page URLs (http/https only)."
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    },
                    "default": {
                        "$ref": "#/components/responses/DefaultError"
                    }
                }
            }
        },
        "/index.php?module=API&method=SEOWebVitals.getWebVitals": {
            "get": {
                "tags": [
                    "SEOWebVitals"
                ],
                "description": "Get Web Vitals report data.",
                "operationId": "SEOWebVitals.getWebVitals",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/formatOptional"
                    },
                    {
                        "name": "idSite",
                        "in": "query",
                        "description": "The site ID.",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "period",
                        "in": "query",
                        "description": "Report period identifier.",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "day",
                                "week",
                                "month",
                                "year",
                                "range"
                            ]
                        }
                    },
                    {
                        "name": "date",
                        "in": "query",
                        "description": "Date string or Date instance. Accepted keywords: 'today', 'yesterday', 'now', 'yesterdaySameTime', 'tomorrow', 'last week', 'last month', 'last year'; accepted formats: 'YYYY-MM-DD' or 'YYYY-MM-DD HH:MM:SS'; date ranges are supported as 'YYYY-MM-DD,YYYY-MM-DD'.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "idSubtable",
                        "in": "query",
                        "description": "Subtable ID (numeric) or 'all' to load all subtables.",
                        "required": false,
                        "schema": {
                            "oneOf": [
                                {
                                    "type": "integer"
                                },
                                {
                                    "type": "string",
                                    "default": "null"
                                }
                            ]
                        }
                    },
                    {
                        "name": "expanded",
                        "in": "query",
                        "description": "If true, loads all subtables.",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    {
                        "name": "flat",
                        "in": "query",
                        "description": "If true, loads all subtables and disables recursive filters.",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "default": false
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Web Vitals report data table."
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    },
                    "default": {
                        "$ref": "#/components/responses/DefaultError"
                    }
                }
            }
        }
    },
